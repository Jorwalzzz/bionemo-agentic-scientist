# ═══════════════════════════════════════════════════════════════════════════════
# NVIDIA BioNeMo & NIM Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# 1. Sign up for free at: https://build.nvidia.com (includes 1,000 free GPU credits)
# 2. Select any biological NIM (e.g. MolMIM or DiffDock) and click "Get API Key"
# 3. Paste your key below (starts with nvapi-...).
# 
# NOTE: If left blank, Agentic BioNeMo runs 100% free locally in high-fidelity 
# mock simulation mode with zero API credits required!
NVIDIA_API_KEY=nvapi-your-key-here

# Set to true to force zero-credit simulation mode, or false for live GPU inference
USE_MOCK=false
